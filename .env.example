# Public, browser-safe Cloudinary product environment name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only credentials. Never add NEXT_PUBLIC_ to the secret.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Future reviewer cookie secret, at least 32 random characters.
DEMO_SESSION_SECRET=

# Cost controls. Neither live execution nor paid AI analysis is enabled initially.
ENABLE_LIVE_PIPELINE=false
ENABLE_PAID_ANALYSIS=false

# Application limit, not a Cloudinary platform limit.
MAX_UPLOAD_BYTES=4000000
