# Public, browser-safe Cloudinary product environment name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only credentials. Never add NEXT_PUBLIC_ to the secret.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reviewer cookie and upload-ticket secret, at least 32 random characters.
DEMO_SESSION_SECRET=

# Enable local uploads and one fixed transformation per prepared output.
# Production uses saved outputs only; the flag cannot enable public writes.
ENABLE_LIVE_PIPELINE=false
# Paid analysis stays unavailable even if this flag changes.
ENABLE_PAID_ANALYSIS=false

# Application limit, not a Cloudinary platform limit.
MAX_UPLOAD_BYTES=4000000
